venv/
__pycache__/
*.pyc
.env
.vscode/

# Derived caches and provider snapshots: rebuildable from data/raw/, so they
# stay out of git. Everything the replay proof needs is tracked below.
data/*.parquet
data/*_fundamentals_*.json
data/decision_audit.jsonl
data/paper_orders.jsonl

# The event-memory store. Its INFERRED memories are derived: the backfill
# rebuilds them deterministically from data/raw/ via
# `python scripts/build_event_memory.py --mode backfill --years 15`, so
# shipping ~3k generated rows would be committing a cache.
#
# NOTE for whoever turns the forward builder on: OBSERVED memories are NOT
# rebuildable, because the news window that produced them closes after
# NEWS_LOOKBACK_DAYS (7) and the articles are gone. Once real observed
# memories start accruing, this store stops being a cache and needs either a
# tracked observed-only file or a backup that is not git.
data/event_memory.jsonl

# Collection run artefacts. The report is an operational log of WHEN the
# collector ran, not evidence for any score, and collect.log is raw stdout.
# The coverage gate reads the report locally; committing it would mean every
# machine's schedule history colliding in one file.
data/collection_report.jsonl
data/collect.log

# NOT ignored (tracked on purpose): data/raw/ is the W6 append-only
# provenance ledger and data/feature_registry.jsonl is the M1 registry.
# "delete derived cache -> rebuild from raw -> reproduce the same result"
# is only executable by a fresh clone if these travel with the repo.
